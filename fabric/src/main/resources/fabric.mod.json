{
	"schemaVersion": 1,
	"id": "pocket_list",
	"version": "${version}",
	"name": "Pocket List",
	"description": "A little checklist in the corner of your screen. Add items by name or pin them from your inventory, recipe book, JEI or REI; break things down into their ingredients; and watch the list tick itself off as you gather from your inventory, the boxes and bundles you carry, and the chests you've opened nearby.",
	"authors": [
		"Gabby"
	],
	"contact": {
		"homepage": "https://github.com/gabmaybelle/pocket-list",
		"sources": "https://github.com/gabmaybelle/pocket-list",
		"issues": "https://github.com/gabmaybelle/pocket-list/issues"
	},
	"license": "MIT",
	"icon": "assets/pocket_list/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.gabbymaybelle.pocketlist.fabric.PocketListFabric"
		],
		"modmenu": [
			"com.gabbymaybelle.pocketlist.fabric.ModMenuIntegration"
		],
		"jei_mod_plugin": [
			"com.gabbymaybelle.pocketlist.compat.JeiPlugin"
		]
	},
	"mixins": [
		"pocket_list.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"fabric-api": ">=0.92.0",
		"minecraft": "1.20.1",
		"java": ">=17"
	},
	"suggests": {
		"modmenu": "*",
		"jei": "*",
		"roughlyenoughitems": "*"
	}
}
